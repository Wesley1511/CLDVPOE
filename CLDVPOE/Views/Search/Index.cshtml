@model CLDVPOE.Models.SearchResultsViewModel

<h2>Search & Filter</h2>

<form asp-action="Index" asp-controller="Search" method="get">
    <div style="display:flex; flex-wrap:wrap; gap:12px; margin-bottom:20px; align-items:flex-end;">

        <div>
            <label>Search</label><br />
            <input type="text" name="q" value="@Model.Query" placeholder="Search..." />
        </div>

        <div>
            <label>Event Type</label><br />
            <select name="eventTypeID" asp-items="@(new SelectList(Model.EventTypes, "EventTypeID", "TypeName", Model.SelectedEventTypeID))">
                <option value="">All Types</option>
            </select>
        </div>

        <div>
            <label>Start Date</label><br />
            <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div>
            <label>End Date</label><br />
            <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div>
            <label>Venue Availability</label><br />
            <select name="venueAvailable">
                <option value="">All</option>
                <option value="true" selected="@(Model.VenueAvailable == true)">Available</option>
                <option value="false" selected="@(Model.VenueAvailable == false)">Unavailable</option>
            </select>
        </div>

        <div>
            <button type="submit">Search</button>
        </div>
    </div>
</form>

@if (Model.Venues.Count == 0 && Model.Events.Count == 0 && Model.Bookings.Count == 0 && Model.Query != null)
{
    <p>No results found.</p>
}

@if (Model.Venues.Count > 0)
{
    <h3>Venues</h3>
    <table>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Available</th>
            <th>Actions</th>
        </tr>
        @foreach (var v in Model.Venues)
        {
            <tr>
                <td>@v.VenueName</td>
                <td>@v.Location</td>
                <td>@v.Capacity</td>
                <td>@(v.IsAvailable ? "Yes" : "No")</td>
                <td>
                    <a href="/Venue/Edit/@v.VenueID">Edit</a> |
                    <a href="/Venue/Delete/@v.VenueID">Delete</a>
                </td>
            </tr>
        }
    </table>
}

@if (Model.Events.Count > 0)
{
    <h3>Events</h3>
    <table>
        <tr>
            <th>Name</th>
            <th>Type</th>          @* ✅ Already here *@
            <th>Start</th>
            <th>End</th>
            <th>Actions</th>
        </tr>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.EventName</td>
                <td>@e.EventType?.TypeName</td>   @* ✅ Already here *@
                <td>@e.StartDate.ToShortDateString()</td>
                <td>@e.EndDate.ToShortDateString()</td>
                <td>
                    <a href="/Event/Edit/@e.EventID">Edit</a> |
                    <a href="/Event/Delete/@e.EventID">Delete</a>
                </td>
            </tr>
        }
    </table>
}

@if (Model.Bookings.Count > 0)
{
    <h3>Bookings</h3>
    <table>
        <tr>
            <th>Date</th>
            <th>Status</th>
            <th>Event</th>
            <th>Event Type</th>    @* ✅ Added *@
            <th>Venue</th>
        </tr>
        @foreach (var b in Model.Bookings)
        {
            <tr>
                <td>@b.BookingDate.ToShortDateString()</td>
                <td>@b.BookingStatus</td>
                <td>@b.Event?.EventName</td>
                <td>@b.Event?.EventType?.TypeName</td>   @* ✅ Added *@
                <td>@b.Venue?.VenueName</td>
            </tr>
        }
    </table>
}